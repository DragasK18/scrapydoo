    return jsonify(recetapp_svc.precios_info())


@app.post("/api/recetapp/run")
def api_recetapp_run():
    """Lanza scraper.py en segundo plano. Body: { farmacias?: [...], max_paginas?: n }."""
    data = request.get_json(silent=True) or {}
    farmacias = data.get("farmacias") or None
    if isinstance(farmacias, str):
        farmacias = [farmacias]
    max_paginas = data.get("max_paginas") or None
    job_id = recetapp_svc.start_job(farmacias, max_paginas)
    return jsonify({"job_id": job_id})


@app.get("/api/recetapp/progress/<job_id>")
def api_recetapp_progress(job_id):
    """Registro de salida en vivo del scraper."""
    job = recetapp_svc.get_job(job_id)
    if job is None:
        return jsonify({"error": "Trabajo no encontrado."}), 404
    return jsonify(job)


@app.route("/recetapp/")
def recetapp_index():
