"""
Retail Price Intelligence Colombia — Aplicación Flask.

Punto de entrada único de la plataforma. Expone:
  - El dashboard web (frontend).
  - Una API REST para consulta de precios, históricos, dashboard, alertas,
    exportación a Excel y carga masiva.

Ejecutar con:
    pip install -r requirements.txt
    python app.py
"""
from __future__ import annotations

import logging
from datetime import datetime, timedelta
from pathlib import Path

from flask import Flask, jsonify, redirect, render_template, request, send_file, send_from_directory, session, url_for
from flask_cors import CORS
from werkzeug.utils import secure_filename

from config import (
    CATEGORIES,
    HOME_RETAILER,
    LOGS_DIR,
    RETAILERS,
    STATIC_DIR,
    SUBCATEGORIES,
    TEMPLATES_DIR,
    UPLOADS_DIR,
    Config,
    active_stores,
)
from database import init_db, repository
from export import export_report
from services import auth, bulk, catalog_import, catalog_extract, pricing_service, recetapp as recetapp_svc
from services.catalog_import import ensure_default_makro_catalog
from services.keys import synthetic_key
from services.weight import format_weight_for_query, format_weight_label, parse_weight

# ──────────────────────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────────────────────
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
    handlers=[
        logging.StreamHandler(),
        logging.FileHandler(LOGS_DIR / "app.log", encoding="utf-8"),
    ],
)
logger = logging.getLogger("app")

# ──────────────────────────────────────────────────────────────────────────
# APP FACTORY
# ──────────────────────────────────────────────────────────────────────────
app = Flask(
    __name__,
    template_folder=str(TEMPLATES_DIR),
    static_folder=str(STATIC_DIR),
    static_url_path="/static",
)
app.config["SECRET_KEY"] = Config.SECRET_KEY
app.config["MAX_CONTENT_LENGTH"] = 16 * 1024 * 1024  # 16 MB para cargas masivas
app.config["PERMANENT_SESSION_LIFETIME"] = timedelta(hours=12)
CORS(app)

# Inicializar base de datos al arrancar.
init_db()
_seed = ensure_default_makro_catalog()
if _seed:
    logger.info(
        "Catálogo Makro cargado: %s productos (%s con SKU)",
        _seed.get("imported"),
        _seed.get("with_sku"),
    )

# Crear el administrador inicial si aún no hay usuarios.
_created_admin = auth.seed_admin()
if _created_admin:
    logger.info("Usuario administrador inicial creado: %s", auth.ADMIN_USERNAME)
if auth.is_default_admin_password():
    logger.warning("ADVERTENCIA: el administrador usa la contraseña por defecto. Cámbiala desde Usuarios.")


# ──────────────────────────────────────────────────────────────────────────
# AUTENTICACIÓN Y AUDITORÍA
# ──────────────────────────────────────────────────────────────────────────
PUBLIC_ENDPOINTS = {"login_page", "api_login", "api_logout"}


@app.before_request
def _require_auth():
    if request.endpoint in PUBLIC_ENDPOINTS:
        return None
    if "user_id" not in session:
        if request.path.startswith("/api/"):
            return jsonify({"error": "No autenticado."}), 401
        return redirect(url_for("login_page"))
    return None


@app.get("/login")
def login_page():
    """Página de ingreso (autocontenida)."""
    if "user_id" in session:
        return redirect(url_for("index"))
    return render_template("login.html")


@app.post("/api/login")
def api_login():
    data = request.get_json(silent=True) or {}
    username = str(data.get("username", "")).strip()
    password = str(data.get("password", "") or "")

    fwd = request.headers.get("X-Forwarded-For", "")
    ip = fwd.split(",")[0].strip() if fwd else (request.remote_addr or "")
    ua = (request.headers.get("User-Agent", "") or "")[:400]

    user = auth.authenticate(username, password)
    if user:
        session.clear()
        session["user_id"] = user["id"]
        session["username"] = user["username"]
        session.permanent = True
        repository.update_user(user["id"], last_login_at=datetime.utcnow())
        auth.record_login(username, True, ip, ua)
        return jsonify({
            "ok": True,
            "user": {
                "id": user["id"],
                "username": user["username"],
                "full_name": user["full_name"],
                "role": user["role"],
            },
            "warn_default_password": user["role"] == "admin" and auth.is_default_admin_password(),
        })

    auth.record_login(username or "(vacío)", False, ip, ua)
    return jsonify({"error": "Usuario o contraseña incorrectos."}), 401


@app.post("/api/logout")
def api_logout():
    session.clear()
    return jsonify({"ok": True})


@app.get("/api/me")
def api_me():
    user = auth.current_user()
    if not user:
        return jsonify({"error": "No autenticado."}), 401
    return jsonify({
        "id": user["id"],
        "username": user["username"],
        "full_name": user["full_name"],
        "role": user["role"],
        "warn_default_password": user["role"] == "admin" and auth.is_default_admin_password(),
    })


def _admin_only():
    return None if auth.is_admin() else (jsonify({"error": "Requiere permisos de administrador."}), 403)


@app.get("/api/users")
def api_users():
    err = _admin_only()
    if err:
        return err
    return jsonify(repository.list_users())


@app.post("/api/users")
def api_users_create():
    err = _admin_only()
    if err:
        return err
    data = request.get_json(silent=True) or {}
    username = str(data.get("username", "")).strip().lower()
    full_name = str(data.get("full_name", "")).strip() or None
    password = str(data.get("password", "") or "")
    role = str(data.get("role", "")).strip().lower() or "user"
    if role not in ("admin", "user"):
        role = "user"
    if not username or not password:
        return jsonify({"error": "El usuario y la contraseña son obligatorios."}), 400
    if len(password) < 6:
        return jsonify({"error": "La contraseña debe tener al menos 6 caracteres."}), 400
    if repository.get_user_by_username(username):
        return jsonify({"error": "Ese nombre de usuario ya existe."}), 409
    created = repository.create_user(username, auth.hash_password(password), full_name, role)
    return jsonify(created), 201


@app.post("/api/users/<int:uid>")
def api_users_update(uid):
    err = _admin_only()
    if err:
        return err
    me = auth.current_user()
    data = request.get_json(silent=True) or {}
    fields = {}
    if "full_name" in data:
        fields["full_name"] = str(data["full_name"]).strip() or None
    if data.get("role") in ("admin", "user"):
        fields["role"] = data["role"]
    if "is_active" in data:
        fields["is_active"] = bool(data["is_active"])
    if data.get("password"):
        pw = str(data["password"])
        if len(pw) < 6:
            return jsonify({"error": "La contraseña debe tener al menos 6 caracteres."}), 400
        fields["password_hash"] = auth.hash_password(pw)
    if me and me["id"] == uid:
        if fields.get("is_active") is False:
            return jsonify({"error": "No puedes desactivar tu propia cuenta."}), 400
        if fields.get("role") and fields["role"] != "admin":
            return jsonify({"error": "No puedes quitarte el rol de administrador a ti mismo."}), 400
    updated = repository.update_user(uid, **fields)
    if not updated:
        return jsonify({"error": "Usuario no encontrado."}), 404
    return jsonify(updated)


@app.delete("/api/users/<int:uid>")
def api_users_delete(uid):
    err = _admin_only()
    if err:
        return err
    me = auth.current_user()
    if me and me["id"] == uid:
        return jsonify({"error": "No puedes eliminar tu propia cuenta."}), 400
    otros_admins = [u for u in repository.list_users() if u["role"] == "admin" and u["id"] != uid]
    if not otros_admins:
        return jsonify({"error": "Debe quedar al menos un administrador."}), 400
    if not repository.delete_user(uid):
        return jsonify({"error": "Usuario no encontrado."}), 404
    return jsonify({"ok": True})


@app.get("/api/audit")
def api_audit():
    err = _admin_only()
    if err:
        return err
    return jsonify(repository.list_login_logs(limit=int(request.args.get("limit", 300))))


