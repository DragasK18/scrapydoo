# Copia este archivo como ".env" en la MISMA carpeta del proyecto y cambia los valores.
# El archivo .env está en .gitignore, así que no se sube a ningún repositorio.

# Clave de sesión (OBLIGATORIO: cadena larga y aleatoria).
# Genérala con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Primer administrador (solo se usa si aún no hay usuarios en la base de datos).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pon-una-contrasena-fuerte

# Con HTTPS (Caddy/Nginx) pon true. Para probar en local sin HTTPS, déjalo false.
SESSION_COOKIE_SECURE=true

# Modo producción
FLASK_DEBUG=false

# La app se queda en localhost; el proxy (Caddy) es quien la publica al exterior.
HOST=127.0.0.1
PORT=5000
